# ============================================
#  WHITELIST MODEL — everything is ignored
#  unless explicitly allowed below.
#
#  If it is not the published word of the
#  Meridian Codex, it does not belong here.
# ============================================

# Ignore everything by default
*

# ============================================
#  ALLOWED: The published Meridian Codex
# ============================================

# Repo infrastructure
!.gitignore
!README.md
!CONTRIBUTING.md
!LICENSE
!PRIVACY.md

# Signed front matter, separate from the core Codex chapters
!foreword.mdx

# The Codex (core framework)
!codex/
!codex/*.mdx

# The Range Audit
!audit/
!audit/*.mdx

# The Governance Layer (specification, critique, amendment log, case records, disconfirmation, changelog)
!governance/
!governance/*.mdx

# The Workshop (categories + architecture pages + tool profiles)
# Two-level structure per workshop-category-pages-two-surface-architecture (2026-05-13):
#   workshop/[category-slug]/index.mdx        — entry-point category page
#   workshop/[category-slug]/architecture.mdx — Architecture page
#   workshop/[category-slug]/[tool-slug].mdx  — tool profile
!workshop/
!workshop/*/
!workshop/*/*.mdx

# The Compact: the Meridian Compact set out in full, with its landing and history pages
# (Carsten's permission, 2026-10-14):
#   compact/COMPACT.md  — the text people download, take up and adapt
#   compact/*.mdx       — the section's landing page and history page
!compact/
!compact/*.mdx
!compact/COMPACT.md

# Retired files: no longer current, kept unchanged as history, off the website
# (Carsten's decision, 2026-10-15; their old web addresses forward here):
#   retired/README.md  — what is kept here and why
#   retired/*.mdx      — pages as they were last published on meridiancodex.com
#   retired/*.md       — files as they were downloaded and read
!retired/
!retired/*.mdx
!retired/*.md
